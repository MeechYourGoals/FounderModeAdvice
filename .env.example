# Supabase Configuration (required for every build)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Public app URL used by web redirects and store review links
VITE_APP_URL=https://foundermodeadvice.com

# Stripe Configuration (web-only subscriptions; never shown inside iOS/Android native app contexts)
VITE_STRIPE_SEED_PRICE_ID=price_xxxx
VITE_STRIPE_SERIES_Z_PRICE_ID=price_xxxx

# RevenueCat Configuration (required for iOS/Android in-app purchases)
# These are platform-specific public SDK keys from RevenueCat → Project settings → API keys.
VITE_REVENUECAT_IOS_API_KEY=appl_xxxx
VITE_REVENUECAT_ANDROID_API_KEY=goog_xxxx

# OneSignal Configuration (installed-app push only; optional until push is enabled)
VITE_ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# RevenueCat dashboard identifiers that must match src/types/subscription.ts and the sync edge function:
# Primary entitlement: Founder Mode Advisor Pro (or founder_mode_advisor_pro if your dashboard rejects spaces)
# Legacy/compat entitlements: seed_subscription, series_z_subscription
# Products/packages: seed_monthly, series_z_monthly

# Supabase Edge Function Environment Variables (set in Supabase dashboard, not in frontend hosting):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# STRIPE_SECRET_KEY=sk_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx
# STRIPE_SEED_PRICE_ID=price_xxxx
# STRIPE_SERIES_Z_PRICE_ID=price_xxxx
# REVENUECAT_API_KEY=xxxx
# ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ONESIGNAL_REST_API_KEY=xxxx
# APP_URL=https://foundermodeadvice.com
# LOVABLE_API_KEY=xxxx

# Store screenshot generation (local/CI only)
APP_SCREENSHOT_BASE_URL=http://localhost:8080
APP_SCREENSHOT_DIR=screenshots
APP_SCREENSHOT_EMAIL=reviewer@example.com
APP_SCREENSHOT_PASSWORD=replace-me
