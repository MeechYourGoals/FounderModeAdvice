# VITE_SUPABASE_URL — public Supabase project URL; required in every web build.
VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY — public/anon client key; never use service role.
VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_APP_URL — canonical deployed web origin.
VITE_APP_URL=
# VITE_STRIPE_SEED_PRICE_ID — legacy/web Stripe price identifier, if retained.
VITE_STRIPE_SEED_PRICE_ID=
# VITE_STRIPE_SERIES_Z_PRICE_ID — legacy/web Stripe price identifier, if retained.
VITE_STRIPE_SERIES_Z_PRICE_ID=
# VITE_REVENUECAT_IOS_API_KEY — public Apple app SDK key for legacy Capacitor runtime.
VITE_REVENUECAT_IOS_API_KEY=
# VITE_REVENUECAT_ANDROID_API_KEY — public Google app SDK key for legacy Capacitor runtime.
VITE_REVENUECAT_ANDROID_API_KEY=
# VITE_ONESIGNAL_APP_ID — public installed-app OneSignal application identifier.
VITE_ONESIGNAL_APP_ID=
# VITE_POSTHOG_KEY — public PostHog project key; leave empty until consent behavior is approved.
VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST — PostHog ingestion host.
VITE_POSTHOG_HOST=
# VITE_DESPIA_POSTHOG_ENABLED — legacy Despia analytics feature flag.
VITE_DESPIA_POSTHOG_ENABLED=

# FMA_APP_ENV — Expo app environment name; set by eas.json.
FMA_APP_ENV=
# FMA_WEB_URL — hosted web origin embedded by the Expo shell; production is guarded.
FMA_WEB_URL=
# FMA_REVENUECAT_IOS_API_KEY — public Apple app-specific SDK key embedded in Expo binary.
FMA_REVENUECAT_IOS_API_KEY=
# FMA_REVENUECAT_ANDROID_API_KEY — public Google app-specific SDK key embedded in Expo binary.
FMA_REVENUECAT_ANDROID_API_KEY=
# FMA_ONESIGNAL_APP_ID — public OneSignal app identifier embedded in Expo binary.
FMA_ONESIGNAL_APP_ID=

# APP_SCREENSHOT_BASE_URL — local/preview origin for capture automation only.
APP_SCREENSHOT_BASE_URL=
# APP_SCREENSHOT_DIR — local raw screenshot output directory.
APP_SCREENSHOT_DIR=
# APP_SCREENSHOT_EMAIL — durable fictional demo account email; local/CI secret only.
APP_SCREENSHOT_EMAIL=
# APP_SCREENSHOT_PASSWORD — durable fictional demo account password; local/CI secret only.
APP_SCREENSHOT_PASSWORD=

# Server-only names (configure in Supabase; never expose to Vite/Expo):
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
# REVENUECAT_API_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
# ONESIGNAL_REST_API_KEY, CRON_SECRET, LOVABLE_API_KEY, APP_URL.
