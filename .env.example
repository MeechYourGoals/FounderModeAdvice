# Supabase Configuration (required for every build)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Public app URL used by web redirects and store review links
VITE_APP_URL=https://foundermodeadvice.com

# Apple Team ID (10-character) used to stamp public/.well-known/apple-app-site-association
# at build time. Universal links and webcredentials stay dormant until this is set.
# VITE_APPLE_TEAM_ID=ABCD123456

# Stripe Configuration (web-only subscriptions; never shown inside iOS/Android native app contexts)
VITE_STRIPE_SEED_PRICE_ID=price_xxxx
VITE_STRIPE_SERIES_Z_PRICE_ID=price_xxxx

# RevenueCat Configuration (required for iOS/Android in-app purchases)
# These are platform-specific public SDK keys from RevenueCat → Project settings → API keys.
VITE_REVENUECAT_IOS_API_KEY=appl_xxxx
VITE_REVENUECAT_ANDROID_API_KEY=goog_xxxx

# OneSignal Configuration (installed-app push only; optional until push is enabled)
# The signed-in Supabase user id is registered as the OneSignal external user id
# (see src/services/pushService.ts) so send-daily-prompt can target each device.
VITE_ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# PostHog Analytics (installed-app analytics; optional until enabled)
# phc_ keys are PUBLIC client keys — safe in frontend env, NOT secrets.
# Despia native runtime uses native PostHog configured in the Despia dashboard
# (the web app talks to it through the posthog:// bridge); the key below is only
# used by the web SDK in Capacitor / installed-PWA runtimes.
VITE_POSTHOG_KEY=phc_xxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_DESPIA_POSTHOG_ENABLED=true

# RevenueCat dashboard identifiers that must match src/types/subscription.ts and the sync edge function:
# Primary entitlement: Founder Mode Advisor Pro (or founder_mode_advisor_pro if your dashboard rejects spaces)
# Legacy/compat entitlements: seed_subscription, series_z_subscription
# Products/packages: seed_monthly, series_z_monthly

# Supabase Edge Function Environment Variables (set in Supabase dashboard, not in frontend hosting):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# STRIPE_SECRET_KEY=sk_xxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxx
# STRIPE_SEED_PRICE_ID=price_xxxx
# STRIPE_SERIES_Z_PRICE_ID=price_xxxx
# REVENUECAT_API_KEY=xxxx
# ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ONESIGNAL_REST_API_KEY=xxxx
# POSTHOG_HOST=https://us.posthog.com  (private app/API host — NOT the ingestion host)
# POSTHOG_PROJECT_ID=xxxx
# POSTHOG_PERSONAL_API_KEY=phx_xxxx  (used only by delete-user-account to erase the person)
# CRON_SECRET=xxxx  (required for send-daily-prompt and generate-recommendations; the scheduler must send it as an `x-cron-secret` header)
#
# --- Weekly discovery (generate-recommendations) ---
# All optional. With none of them set the weekly job still runs and serves the
# curated Inspiration Library; each key added widens where candidates come from.
# EXA_API_KEY=xxxx            (https://dashboard.exa.ai — neural search with a real published-date filter; free tier, no card)
# YOUTUBE_API_KEY=xxxx        (Google Cloud console → YouTube Data API v3 key, HTTP-referrer-unrestricted server key)
# LOVABLE_API_KEY is reused for query expansion + "why this matters to you" reasons.
# ONESIGNAL_* above are reused for the one-per-batch weekly notification.
#
# Cost ceilings (all optional; the defaults in the function are already conservative):
# DISCOVERY_ITEMS_PER_BATCH=10          (recommendations per profile per week; hard max 20)
# DISCOVERY_MAX_PROFILES_PER_RUN=25     (profiles processed per cron tick; hard max 100)
# DISCOVERY_MAX_QUERIES_PER_PROFILE=10  (search intents per profile; hard max 20)
# DISCOVERY_MAX_PROVIDER_CALLS=400      (outbound provider calls per run; hard max 1000)
# PADDLE_ALLOW_SANDBOX_ENTITLEMENTS=true  (staging only — lets sandbox Paddle purchases grant real feature tiers)
# APP_URL=https://foundermodeadvice.com
# LOVABLE_API_KEY=xxxx

# Store screenshot generation (local/CI only)
APP_SCREENSHOT_BASE_URL=http://localhost:8080
APP_SCREENSHOT_DIR=screenshots
APP_SCREENSHOT_EMAIL=reviewer@example.com
APP_SCREENSHOT_PASSWORD=replace-me
