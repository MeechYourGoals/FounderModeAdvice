# Expo public env — bundled into the app (EXPO_PUBLIC_* is exposed to client code,
# exactly like VITE_* on the web). The anon/publishable key is not a secret.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Filled in by `eas init` (or set in the EAS build environment). Not required for
# local `expo start`.
EAS_PROJECT_ID=
