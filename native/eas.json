{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "FMA_APP_ENV": "development" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "FMA_APP_ENV": "preview" }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "FMA_APP_ENV": "production",
        "FMA_WEB_URL": "https://foundermodeadvice.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {
        "serviceAccountKeyPath": "./play-service-account.json",
        "track": "internal"
      }
    }
  }
}
