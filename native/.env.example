# Founder Mode Advice — Expo shell configuration (names only; set real values
# as EAS environment variables per environment, never commit them).

# Web origin the shell loads. Leave unset for production
# (defaults to https://foundermodeadvice.com). For Expo Go against a local
# vite dev server use e.g. http://192.168.1.20:8080
FMA_WEB_URL=

# RevenueCat PUBLIC SDK keys (Project settings → API keys). Platform-specific.
# iOS keys start with "appl_", Android with "goog_". Keys starting with
# "test_" are RevenueCat Test Store keys and are rejected by the production
# build guard in app.config.ts. Public keys — safe in the binary, but manage
# them as EAS environment variables so dev/preview/production can differ.
FMA_REVENUECAT_IOS_API_KEY=
FMA_REVENUECAT_ANDROID_API_KEY=

# OneSignal app id (Settings → Keys & IDs). Required for push notifications;
# the app degrades gracefully without it.
FMA_ONESIGNAL_APP_ID=
