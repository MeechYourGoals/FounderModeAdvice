# @revenuecat/purchases-capacitor@10 declares a peer of @capacitor/core >=7
# while this app (and its native shells) pin Capacitor 6. The resolved tree in
# package-lock.json / bun.lock works at runtime (the plugin only touches APIs
# present in v6), but strict npm peer resolution rejects it — so plain
# `npm install` / `npm ci` fail without this flag. Remove once the app moves
# to Capacitor >=7.
legacy-peer-deps=true
